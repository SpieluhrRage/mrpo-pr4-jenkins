#!/bin/sh
set -eu

case "${1:-}" in
    staging)
        echo "Имитация развёртывания в staging"
        ;;
    prod)
        echo "Имитация развёртывания в production"
        ;;
    *)
        echo "Ошибка: необходимо указать staging или prod"
        exit 1
        ;;
esac

echo "Этап развёртывания завершён"
